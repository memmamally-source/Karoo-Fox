---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Detail from '../components/Detail.astro';
import { company } from '../config/company.ts';
import { apps } from '../data/apps.ts';
import { appPaths, href } from '../lib/url.ts';
const companyContacts = [
  { title: 'General enquiries', text: 'Partnerships, press and other enquiries.', email: company.emails.general },
  { title: 'Support', text: 'Questions about any of our apps.', email: company.emails.support },
  { title: 'Privacy and data requests', text: 'Access, correction or deletion of your personal information.', email: company.emails.privacy },
].filter((c) => c.email);
---
<Base title="Contact" description="How to contact Karoo Fox for app support, privacy requests and other enquiries.">
  <PageHeader title="Contact us" eyebrow="Get in touch" lead="We read every message. For help with an app, email that app’s support address below." crumbs={[{ label: 'Contact' }]} />
  {companyContacts.length > 0 && (
    <section class="section" aria-label="Karoo Fox contacts">
      <div class="container grid">
        {companyContacts.map((c) => (
          <div class="card contact-item">
            <h2 class="h3">{c.title}</h2>
            <p class="muted">{c.text}</p>
            <p><Detail value={c.email} email /></p>
          </div>
        ))}
      </div>
    </section>
  )}
  <section class="section" aria-labelledby="app-support">
    <div class="container">
      <h2 id="app-support">App support</h2>
      <div class="grid">
        {apps.map((app) => (
          <div class="card contact-item">
            <h3>{app.name}</h3>
            {app.supportEmail && <p><Detail value={app.supportEmail} email /></p>}
            <p><a href={href(appPaths(app.slug).support)}>Help and FAQs</a> · <a href={href(appPaths(app.slug).deleteData)}>Delete your data</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
